# Copy to ~/.config/runner-ctl/env and edit. Keep this file and the files it points to outside any
# repository: they hold the list of repositories and a token. The file is read by bash, so $HOME works.
RUNNER_CTL_REPOS_FILE="$HOME/.config/runner-ctl/repos"
RUNNER_CTL_TOKEN_FILE="$HOME/.config/runner-ctl/token"
# Stop a runner after this many idle minutes.
RUNNER_CTL_IDLE_MINUTES=15
# Start a runner only for a job that has waited this long. Use a different value per host so the
# host with the shorter delay gets the job first: a few seconds for the extra replicas of the
# primary host, several minutes (for example 240) for slower secondary hosts. See "Tuning the delays".
RUNNER_CTL_START_DELAY=60
# Upper bound on running containers that runner-ctl manages on this host.
RUNNER_CTL_MAX_RUNNING=4
# Start a runner that has been stopped for this many days even with no job, so that GitHub does
# not delete its registration (it does after 14 days without a connection). 0 disables it.
RUNNER_CTL_KEEPALIVE_DAYS=7
# Primary host only: leave ar-<repo> (the first container) running and manage the extra replicas.
# RUNNER_CTL_KEEP_PRIMARY=1
