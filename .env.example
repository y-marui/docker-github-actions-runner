# Copy to `.env` (or `.env.<name>` for an additional runner) and fill in.
# These files are gitignored. Never commit real values.

# Repository this runner serves.
REPO_URL=https://github.com/OWNER/REPO

# Registration token, needed on the first start only. Remove it afterwards.
# Get one with: gh api -X POST repos/OWNER/REPO/actions/runners/registration-token --jq .token
# It expires after 1 hour.
RUNNER_TOKEN=

# Optional.
RUNNER_NAME=
# Comma-separated extra labels. Workflows target them with `runs-on: [self-hosted, <label>]`.
RUNNER_LABELS=
